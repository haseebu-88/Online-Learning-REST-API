          ]
        },
        "description": "Requires login token. If category already exists, change the name.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Programming\",\n  \"description\": \"Programming courses\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set('categoryId',pm.response.json().category.id);"
            ]
          }
        }
      ]
    },
